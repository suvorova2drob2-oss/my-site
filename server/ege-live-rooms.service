[Unit]
Description=EGE Live rooms server
After=network.target

[Service]
Type=simple
WorkingDirectory=/root/my-site
Environment=PORT=8787
Environment=ALLOWED_ORIGINS=*
Environment=PUBLIC_ORIGIN=https://77-110-113-165.sslip.io
Environment=ROBLOX_ROOT=/root/roblox
Environment=CLUMSY_ROOT=/root/clumsy-and-his-friends
Environment=TEACHER_STORE_DIR=/root/teacher-store-data
ExecStart=/usr/bin/npm run live:rooms
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
