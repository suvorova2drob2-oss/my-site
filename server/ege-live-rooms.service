[Unit]
Description=EGE Live rooms server
After=network.target

[Service]
Type=simple
WorkingDirectory=/root/my-site
Environment=PORT=8787
Environment=ALLOWED_ORIGINS=*
Environment=PUBLIC_ORIGIN=http://77.110.113.165:8787
ExecStart=/usr/bin/npm run live:rooms
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
